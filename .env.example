# Optional GA4 Advanced Consent Mode: tag loads with analytics storage denied.
# Set to G-82FJCYXT95 in an intentionally configured Preview/Production build.
VITE_GA4_MEASUREMENT_ID=

# Optional advertising. Leave blank until approved account IDs are available.
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_PRIMARY_SLOT=

# Deliberately omitted by default. See the dictionary documentation before use.
WORDCABIN_DICTIONARY_SOURCES=
WORDCABIN_ALLOW_PRODUCTION_DICTIONARY_WRITE=

# Advertising stays OFF until account approval, certified CMP setup and owner QA.
VITE_ADS_ENABLED=false
# Exact certified CMP ID; never a substitute for installing/configuring that CMP.
VITE_ADS_CMP_ID=
